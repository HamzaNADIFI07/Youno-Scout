# Groq API key for LLM-based company brief generation
# Get yours for free at https://console.groq.com/keys (no credit card required)
GROQ_API_KEY=gsk_...

# Optional: override the Groq model used for analysis
# Default: llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Hunter.io for email enrichment by domain (25 lookups / month free)
# Sign up at https://hunter.io/api-keys
# HUNTER_API_KEY=

# Optional: CompanyEnrich for company data enrichment (50 lookups / day free)
# Sign up at https://app.companyenrich.com
# COMPANY_ENRICH_API_KEY=
