# ============================================================================
# Scout — variables d'environnement
# ============================================================================
# Copiez ce fichier vers .env.local puis remplissez les valeurs.
# `npm run dev` charge automatiquement .env.local au démarrage.

# ----------------------------------------------------------------------------
# Fournisseurs LLM (chaîne de fallback, voir src/server/llm/providers.ts)
# ----------------------------------------------------------------------------
# Au moins UNE clé suffit pour faire tourner l'app. Les clés vides sont
# silencieusement sautées par le router. Le mieux est d'en avoir au moins 2-3
# pour bénéficier du fallback automatique quand un provider sature.
# Plus de détails dans le README, section "Système multi-provider LLM".

# Groq — Llama 3.3 70B, le plus rapide (~200ms). Free tier 14 400 req/jour.
# Inscription : https://console.groq.com/keys (sans carte bancaire)
GROQ_API_KEY=

# OpenRouter — bascule entre 3 modèles free (Llama 3.3, Qwen3 80B, DeepSeek V4).
# 1 clé = accès à plusieurs modèles. Pool free-tier intermittent.
# Inscription : https://openrouter.ai/keys (sans carte bancaire)
OPENROUTER_API_KEY=

# Mistral La Plateforme — modèles natifs français (Large pour analyse, Small
# pour génération de signaux). Free tier "Experiment" généreux (500k tokens/min).
# Inscription : https://console.mistral.ai (vérification téléphone requise)
MISTRAL_API_KEY=

# Google Gemini 2.5 Flash — quota séparé de Groq, fallback de confort.
# Free tier : 1M tokens/jour. Inscription : https://aistudio.google.com
GEMINI_API_KEY=

# ----------------------------------------------------------------------------
# APIs d'enrichissement (toutes optionnelles, activables via l'UI)
# ----------------------------------------------------------------------------

# Hunter.io — emails publics professionnels du domaine cible (25 lookups/mois)
# https://hunter.io/api-keys
HUNTER_API_KEY=

# CompanyEnrich — fiche entreprise enrichie (taille, fondation, LinkedIn…)
# https://app.companyenrich.com (50 lookups/jour free tier)
COMPANY_ENRICH_API_KEY=

# Clearbit Logo n'a PAS de clé : c'est un endpoint public
# (https://logo.clearbit.com/{domain}). Rien à configurer ici.

# ----------------------------------------------------------------------------
# Base de données Neon Postgres
# ----------------------------------------------------------------------------
# Utilisée pour stocker les emails du gate (table email_subscribers).
# Free tier : 0.5 Go, suffisant pour des millions de subscribers.
# Inscription : https://console.neon.tech (sans carte bancaire)
# Format : postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require
NEON_DATABASE_URL=

# ----------------------------------------------------------------------------
# Resend (envoi de l'email de double opt-in)
# ----------------------------------------------------------------------------
# https://resend.com/api-keys (free tier : 3 000 emails/mois, 100/jour)
RESEND_API_KEY=

# Adresse d'envoi vérifiée dans Resend (DKIM + SPF doivent être configurés
# dans la console Resend pour ce domaine).
RESEND_FROM_EMAIL=contact@votre-domaine.fr

# ----------------------------------------------------------------------------
# URL publique de l'app (pour les liens dans les emails et redirections)
# ----------------------------------------------------------------------------
# En dev :   http://localhost:3000
# En prod :  https://scout.votre-domaine.fr (ou l'URL Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Secret de signature des cookies de session (HMAC-SHA256)
# ----------------------------------------------------------------------------
# OBLIGATOIRE pour le gate email. Minimum 32 caractères.
# Génération recommandée :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Ne jamais commiter cette valeur en production.
SCOUT_SESSION_SECRET=

# ----------------------------------------------------------------------------
# Observabilité (logs serveur)
# ----------------------------------------------------------------------------
# Niveau de log pino. En dev par défaut : "debug" (lisible via pino-pretty).
# En prod par défaut : "info" (JSON sur stdout, drainé par Vercel).
# Valeurs : trace | debug | info | warn | error | fatal | silent
# LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Rate limiting (Upstash Redis serverless)
# ----------------------------------------------------------------------------
# Optionnel : si non configuré, le rate limiting est désactivé en local.
# En prod, OBLIGATOIRE pour protéger les routes coûteuses (LLM, email).
# Free tier : 10 000 commandes/jour, sans CB.
# Inscription : https://console.upstash.com (intégration Vercel native)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
